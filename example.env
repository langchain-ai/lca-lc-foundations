# Manual installs for checking: uv

# Required for direct-provider chat (default); also needed by bonus RAG embeddings
OPENAI_API_KEY='your_openai_api_key_here'

# Required for web search in either chat mode
TAVILY_API_KEY='your_tavily_api_key_here'

# optional, only used in Module 1, Lesson 1 once
ANTHROPIC_API_KEY='your_anthropic_api_key_here'
GOOGLE_API_KEY='your_google_api_key_here'

# Optional for evaluation and tracing
LANGSMITH_API_KEY='your_langsmith_api_key_here'
# uncomment to set tracing to true when you set up your LangSmith account
# LANGSMITH_TRACING=true
LANGSMITH_AGENT_ID=lca-lc-foundations
LANGSMITH_AGENT_ENVIRONMENT=local
# Uncomment the following if you are on the EU instance:
#LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Optional: route supported LangChain chat models through LangSmith LLM Gateway
# LANGSMITH_GATEWAY=true
# Uses LANGSMITH_API_KEY unless a separate gateway key is provided:
# LANGSMITH_GATEWAY_API_KEY=your_gateway_api_key_here
# For EU, set LANGSMITH_GATEWAY=https://eu.gateway.smith.langchain.com
# Leave provider keys unset in gateway mode, except OPENAI_API_KEY for bonus RAG.
